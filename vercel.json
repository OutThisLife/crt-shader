{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run ci",
  "outputDirectory": "docs/dist",
  "redirects": [
    {"source":"/vanilla/:path*","destination":"/guides/vanilla/","permanent":true},
    {"source":"/react/:path*","destination":"/guides/react/","permanent":true},
    {"source":"/three/:path*","destination":"/guides/three/","permanent":true},
    {"source":"/postprocessing/:path*","destination":"/guides/postprocessing/","permanent":true},
    {"source":"/r3f/:path*","destination":"/guides/r3f/","permanent":true}
  ],
  "headers": [
    {"source":"/_astro/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
    {"source":"/(.*)","headers":[
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}
    ]}
  ]
}
